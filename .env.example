# NEVER commit .env. Use a fresh testnet-only key.
DEPLOYER_KEY=0x...
PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev

# Filled after deploy (scripts/deploy.js writes deployments/<network>.json too)
AGGREGATOR_ADDRESS=
KEEPER_REGISTRY_ADDRESS=

# Agent keys: one key per feeder agent / keeper agent
FEEDER_KEY=0x...
KEEPER_KEY=0x...

# Feeder behaviour
FEEDS=BTC / USD,ETH / USD,DOT / USD
DEVIATION_BPS=50          # submit if price moved >0.5%
HEARTBEAT_SEC=600         # or if no update for 10 min
MAX_SOURCE_SPREAD_BPS=300 # sources disagree >3% -> agent pauses feed
POLL_SEC=30

# Optional LLM reasoning (any OpenAI-compatible endpoint, e.g. NVIDIA build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
