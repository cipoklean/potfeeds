[Unit]
Description=PotFeeds keeper agent (executes due registry jobs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/potfeeds
EnvironmentFile=%h/potfeeds/.env
Environment=NETWORK=portaldotTestnet
ExecStart=%h/potfeeds/node_modules/.bin/tsx agent/src/keeper.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
